{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          {
            "context": "Lint / Typecheck / Test / Build (ubuntu-latest, Node 22)",
            "integration_id": 15368
          },
          {
            "context": "Lint / Typecheck / Test / Build (ubuntu-latest, Node 24)",
            "integration_id": 15368
          },
          {
            "context": "Lint / Typecheck / Test / Build (windows-latest, Node 22)",
            "integration_id": 15368
          },
          {
            "context": "Lint / Typecheck / Test / Build (windows-latest, Node 24)",
            "integration_id": 15368
          },
          {
            "context": "Source branch",
            "integration_id": 15368
          },
          {
            "context": "Version and changelog",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
